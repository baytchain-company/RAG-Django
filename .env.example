# --- Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (docker compose up -d starts one with pgvector)
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Embeddings: sentence-transformers | ollama | openai | hash
RAG_EMBEDDING_PROVIDER=sentence-transformers
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_DIM=384

# --- LLM: ollama | openai | none
RAG_LLM_PROVIDER=ollama
RAG_LLM_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# OpenAI or any OpenAI-compatible API (Groq, OpenRouter, LM Studio...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# --- Retrieval tuning
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_MAX_DISTANCE=0.8
